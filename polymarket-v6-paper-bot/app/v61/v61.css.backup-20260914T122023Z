.v61-shell{--ice:#63e6ff;--violet:#9587ff;--coral:#ff806c;background:radial-gradient(circle at 8% -5%,#123745 0,transparent 31%),radial-gradient(circle at 92% 4%,#2c214e 0,transparent 29%),#071318;color:#eaf8fb}.v61-head h1 i{color:var(--ice)}.v61-kpis{background:#0b1c23;border-color:#29434d}.v61-top,.v61-mid{display:grid;grid-template-columns:1.35fr 1fr 1fr;gap:16px;margin-top:16px}.v61-top>article,.v61-mid>article{background:linear-gradient(145deg,#102832,#0a1b22);border:1px solid #294650;border-radius:18px;padding:24px;min-width:0}.v61-equity-plot{height:218px;display:flex;align-items:flex-end;gap:2px;border-bottom:1px solid #36525b;padding-top:20px;background:linear-gradient(180deg,transparent 49%,#1d374055 50%,transparent 51%)}.v61-equity-plot i{display:block;flex:1;min-width:2px;border-radius:5px 5px 1px 1px;opacity:.88;transition:height .25s ease}.v61-equity-plot .rise{background:linear-gradient(180deg,var(--ice),#2d9eb5)}.v61-equity-plot .fall{background:linear-gradient(180deg,var(--coral),#9e423d)}.v61-scale,.v61-legend{display:flex;justify-content:space-between;color:#90aab3;font-size:10px;margin-top:11px}.v61-market-bars{height:218px;display:flex;align-items:flex-end;gap:5px;border-bottom:1px solid #36525b;padding-top:22px}.v61-market-bars>div{height:100%;flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:6px}.v61-market-bars i{display:block;width:100%;min-width:4px;border-radius:4px 4px 1px 1px}.v61-market-bars .gain,.v61-legend .gain{background:var(--ice)}.v61-market-bars .loss,.v61-legend .loss{background:var(--coral)}.v61-market-bars small{font-size:7px}.v61-legend{justify-content:flex-start;gap:18px}.v61-legend span{display:flex;align-items:center;gap:6px}.v61-legend i{width:9px;height:9px;border-radius:50%}.v61-signal h2{margin-bottom:20px}.v61-signal-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:15px}.v61-signal-grid span{background:#142f39;border:1px solid #23444e;border-radius:10px;padding:10px;font-size:9px;color:#8eabb4}.v61-signal-grid b{display:block;color:#f2fbfd;font-size:12px;margin-top:5px}.v61-signal p{font:14px/1.48 Georgia;color:#9bb1b7;margin:17px 0 0}.v61-donut-wrap{display:flex;align-items:center;gap:24px;margin-top:22px}.v61-donut{width:150px;aspect-ratio:1;border-radius:50%;display:grid;place-content:center;text-align:center;position:relative}.v61-donut:after{content:"";position:absolute;inset:17px;background:#0d222a;border-radius:50%}.v61-donut b,.v61-donut span{position:relative;z-index:1}.v61-donut b{font-size:21px}.v61-donut span{font-size:9px;color:#96adb5}.v61-key{display:grid;gap:13px}.v61-key span{display:flex;align-items:center;gap:8px;color:#a5bbc1}.v61-key i{width:9px;height:9px;border-radius:50%;background:var(--ice)}.v61-key .cash{background:#415c66}.v61-key .fill{background:var(--violet)}.v61-horizon{display:grid;gap:24px;margin-top:28px}.v61-horizon div{display:grid;grid-template-columns:1fr auto;gap:9px}.v61-horizon i{grid-column:1/-1;height:8px;background:#203a43;border-radius:20px;overflow:hidden}.v61-horizon em{display:block;height:100%;background:linear-gradient(90deg,var(--ice),var(--violet));border-radius:20px}.v61-rules{list-style:none;padding:0;margin:18px 0 0}.v61-rules li{padding:9px 0;border-top:1px solid #28434c;color:#9bb1b7}.v61-rules b{color:#fff}.v61-flow{background:#0c2027}.v61-ledger mark.trade{background:var(--ice);border-color:var(--ice)}.v61-ledger mark.manage{background:#d7d0ff;border-color:#d7d0ff}.v61-bottom>article{background:#0c2027}.v61-shell footer{color:#86a4ad}@media(max-width:1100px){.v61-top,.v61-mid{grid-template-columns:1fr}.v61-equity-plot,.v61-market-bars{height:180px}}@media(max-width:620px){.v61-donut-wrap{align-items:flex-start;flex-direction:column}.v61-donut{width:130px}.v61-signal-grid{grid-template-columns:1fr 1fr}}
